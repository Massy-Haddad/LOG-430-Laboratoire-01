# E-commerce Service Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_NAME=pos_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration  
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT Configuration (should match auth service)
JWT_SECRET=your-super-secret-key-change-in-production-min-256-bits-long
JWT_AUDIENCE=log430-api
JWT_ISSUER=log430-auth-service

# Service Configuration
SERVICE_NAME=e-commerce
SERVICE_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
STRICT_RATE_LIMIT_MAX=50

# Monitoring
METRICS_COLLECTION_INTERVAL=60000
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
ENABLE_REQUEST_LOGGING=true

# Cart Configuration
CART_TTL_SECONDS=86400
SESSION_TTL_SECONDS=3600

# Order Configuration
ORDER_NUMBER_PREFIX=ORD
ORDER_STATUS_DEFAULT=pending

# Development Settings
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
ENABLE_CORS_ALL_ORIGINS=false
