{
  "openapi": "3.0.0",
  "info": {
    "title": "LOG430 Gateway API",
    "version": "1.0.0",
    "description": "API Gateway for LOG430 Multi-Store System. This API provides access to store operations including stock management, sales processing, and reporting functionality through KrakenD Gateway.",
    "license": {
      "name": "MIT"
    },
    "contact": {
      "name": "Massy Haddad",
      "email": "massy.haddad.1@ens.etsmtl.ca"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server via KrakenD Gateway"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "🔑 Get Authentication Token",
        "description": "**Step 1:** Use this endpoint to authenticate and get a JWT token.\n\n**Step 2:** Copy the token from the response.\n\n**Step 3:** Click the 'Authorize' button at the top of this page and paste the token.\n\n**Step 4:** Test other endpoints that require authentication.",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "admin",
                    "description": "Username for authentication"
                  },
                  "password": {
                    "type": "string",
                    "example": "password",
                    "description": "Password for authentication"
                  }
                }
              },
              "example": {
                "username": "admin",
                "password": "password"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "JWT access token",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "username": {
                          "type": "string",
                          "example": "admin"
                        },
                        "role": {
                          "type": "string",
                          "example": "admin",
                          "enum": ["admin", "employee", "logistics", "analyst"]
                        },
                        "storeId": {
                          "type": "integer",
                          "nullable": true,
                          "example": null,
                          "description": "Store ID if user is associated with a specific store"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJhZG1pbiIsInJvbGUiOiJhZG1pbiIsInN0b3JlSWQiOm51bGwsImF1ZCI6WyJsb2c0MzAtYXBpIl0sImlzcyI6ImxvZzQzMC1hdXRoLXNlcnZpY2UiLCJleHAiOjE3NTM3NDczNjksImlhdCI6MTc1Mzc0Mzc2OX0.xyz123",
                  "user": {
                    "id": 1,
                    "username": "admin",
                    "role": "admin",
                    "storeId": null
                  },
                  "_instructions": "✅ Copy the 'token' value above and click the 'Authorize' button at the top of this page to use it for authenticated requests."
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Invalid username or password"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Missing or invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Username and password are required"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/store/stock/{storeId}": {
      "get": {
        "summary": "Get store stock information",
        "description": "Retrieves the complete inventory for a specific store including product details, current stock levels, and threshold information",
        "tags": ["store"],
        "parameters": [
          {
            "name": "storeId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the store",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Store inventory retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "storeId": {
                      "type": "integer",
                      "example": 1
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "productId": {
                            "type": "integer",
                            "example": 4
                          },
                          "name": {
                            "type": "string",
                            "example": "Lait"
                          },
                          "stock": {
                            "type": "integer",
                            "example": 93
                          },
                          "threshold": {
                            "type": "integer",
                            "example": 20
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "storeId": 1,
                  "items": [
                    {
                      "productId": 4,
                      "name": "Lait",
                      "stock": 93,
                      "threshold": 20
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid store ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Invalid store ID format"
                }
              }
            }
          },
          "404": {
            "description": "Store not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Store not found"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/store/sales": {
      "post": {
        "summary": "Record a new sale",
        "description": "Records a new sale transaction in the system with product details and quantities",
        "tags": ["store"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["storeId", "products", "total"],
                "properties": {
                  "storeId": {
                    "type": "integer",
                    "example": 1
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "integer",
                          "example": 1
                        },
                        "quantity": {
                          "type": "integer",
                          "example": 2
                        },
                        "price": {
                          "type": "number",
                          "format": "float",
                          "example": 1.5
                        }
                      }
                    }
                  },
                  "total": {
                    "type": "number",
                    "format": "float",
                    "example": 3.0
                  }
                }
              },
              "example": {
                "storeId": 1,
                "products": [
                  {
                    "productId": 1,
                    "quantity": 2,
                    "price": 1.5
                  }
                ],
                "total": 3.0
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sale recorded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "saleId": {
                      "type": "integer",
                      "example": 12345
                    },
                    "message": {
                      "type": "string",
                      "example": "Sale recorded successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid sale data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Invalid sale data provided"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/store/reports/sales": {
      "get": {
        "summary": "Generate sales report",
        "description": "Generates a comprehensive sales report for a specified date range across all stores",
        "tags": ["reports"],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "description": "Start date for the report (ISO 8601 format)",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-06-01"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "description": "End date for the report (ISO 8601 format)",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-06-10"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sales report generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "startDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "endDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "summaryByStore": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "storeName": {
                            "type": "string"
                          },
                          "totalSales": {
                            "type": "number"
                          },
                          "topProducts": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "quantity": {
                                  "type": "integer"
                                },
                                "price": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "startDate": "2025-06-01",
                  "endDate": "2025-06-10",
                  "summaryByStore": [
                    {
                      "storeName": "Magasin Centre-Ville",
                      "totalSales": 42,
                      "topProducts": [
                        {
                          "name": "Pain",
                          "quantity": 5,
                          "price": 1.2
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid date parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Invalid date format or range"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/store/products/{productId}": {
      "put": {
        "summary": "Update product information",
        "description": "Updates the attributes of an existing product such as name, price, and category",
        "tags": ["store"],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the product to update",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Pomme Golden"
                  },
                  "price": {
                    "type": "number",
                    "format": "float",
                    "example": 1.6
                  },
                  "category": {
                    "type": "string",
                    "example": "Fruits"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "price": {
                      "type": "number",
                      "format": "float"
                    },
                    "category": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "id": 1,
                  "name": "Pomme Golden",
                  "price": 1.6,
                  "category": "Fruits",
                  "createdAt": "2025-06-10T12:00:00Z",
                  "updatedAt": "2025-06-10T12:05:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Invalid product data"
                }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Product not found"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/store/metrics": {
      "get": {
        "summary": "Get service metrics",
        "description": "Returns Prometheus-formatted metrics for monitoring and observability",
        "tags": ["monitoring"],
        "responses": {
          "200": {
            "description": "Metrics data in Prometheus format",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "# HELP http_requests_total Total number of HTTP requests\n# TYPE http_requests_total counter\nhttp_requests_total{method=\"GET\",status=\"200\"} 123"
              }
            }
          }
        }
      }
    },
    "/api/v1/ecommerce/cart": {
      "get": {
        "summary": "Get user shopping cart",
        "description": "Retrieves the current user's shopping cart with all items, quantities, and total amount",
        "tags": ["ecommerce"],
        "responses": {
          "200": {
            "description": "Cart retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "userId": {
                          "type": "integer",
                          "example": 1
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "productId": {
                                "type": "integer",
                                "example": 4
                              },
                              "productName": {
                                "type": "string",
                                "example": "Lait"
                              },
                              "quantity": {
                                "type": "integer",
                                "example": 2
                              },
                              "price": {
                                "type": "number",
                                "example": 1.5
                              },
                              "total": {
                                "type": "number",
                                "example": 3.0
                              }
                            }
                          }
                        },
                        "totalItems": {
                          "type": "integer",
                          "example": 2
                        },
                        "totalAmount": {
                          "type": "number",
                          "example": 3.0
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Add item to cart",
        "description": "Adds a new item to the user's shopping cart or updates quantity if item already exists",
        "tags": ["ecommerce"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId", "quantity", "price"],
                "properties": {
                  "productId": {
                    "type": "integer",
                    "example": 4
                  },
                  "quantity": {
                    "type": "integer",
                    "example": 2
                  },
                  "price": {
                    "type": "number",
                    "example": 1.5
                  },
                  "productName": {
                    "type": "string",
                    "example": "Lait"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item added to cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Item added to cart"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "cartItem": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 1
                            },
                            "productId": {
                              "type": "integer",
                              "example": 4
                            },
                            "productName": {
                              "type": "string",
                              "example": "Lait"
                            },
                            "quantity": {
                              "type": "integer",
                              "example": 2
                            },
                            "price": {
                              "type": "number",
                              "example": 1.5
                            },
                            "total": {
                              "type": "number",
                              "example": 3.0
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Validation failed"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/ecommerce/cart/{productId}": {
      "put": {
        "summary": "Update cart item",
        "description": "Updates the quantity of a specific item in the user's cart",
        "tags": ["ecommerce"],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the product to update",
            "schema": {
              "type": "integer",
              "example": 4
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quantity"],
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart item updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Cart item updated"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Invalid quantity"
                }
              }
            }
          },
          "404": {
            "description": "Item not found in cart",
