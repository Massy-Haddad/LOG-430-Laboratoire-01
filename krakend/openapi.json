                      },
                      "postalCode": {
                        "type": "string",
                        "example": "H1A 1A1"
                      },
                      "country": {
                        "type": "string",
                        "example": "Canada"
                      },
                      "state": {
                        "type": "string",
                        "example": "QC"
                      }
                    }
                  },
                  "notes": {
                    "type": "string",
                    "example": "Leave at front door"
                  }
                }
              }
            }
