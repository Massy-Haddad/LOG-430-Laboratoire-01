          "disable_jwk_security": true
        },
        "documentation/openapi": {
          "summary": "Process checkout",
          "description": "Processes the cart checkout, creates an order, and initiates payment",
          "tags": [
            "ecommerce"
          ],
          "request_definition": [
            {
              "content_type": "application/json",
              "description": "Checkout information including payment method and shipping details",
              "example": {
                "paymentMethod": "card",
