{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "krakend-gateway",
  "port": 3000,
  "extra_config": {},
  "endpoints": [
    {
      "endpoint": "/api/v1/stock/{storeId}",
      "method": "GET",
      "backend": [
        {
          "host": ["http://store"],
          "url_pattern": "/api/v1/stock/{storeId}",
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/v1/sales",
      "method": "POST",
      "backend": [
        {
          "host": ["http://store"],
          "url_pattern": "/api/v1/sales",
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/v1/reports/sales",
      "method": "GET",
      "backend": [
        {
          "host": ["http://store"],
          "url_pattern": "/api/v1/reports/sales",
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{productId}",
      "method": "PUT",
      "backend": [
        {
          "host": ["http://store"],
          "url_pattern": "/api/v1/products/{productId}",
          "encoding": "json"
        }
      ]
    }
  ]
}
