{
  "version": 3,
  "name": "log430-gateway",
  "port": 3000,
  "timeout": "3000ms",
  "endpoints": [
    {
      "endpoint": "/api/v1/store/stock/{storeId}",
      "method": "GET",
      "backend": [
        {
          "host": [
            "http://store:3000"
          ],
          "url_pattern": "/api/v1/store/stock/{storeId}",
          "encoding": "json",
          "input_parameters": [
            {
              "name": "storeId",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/store/metrics",
      "method": "GET",
      "backend": [
        {
          "host": [
            "http://store:3000"
          ],
          "url_pattern": "/api/v1/store/metrics",
          "encoding": "no-op"
        }
      ]
    }
  ]
}
