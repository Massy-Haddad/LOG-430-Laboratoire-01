{
  "version": 3,
  "name": "log430-gateway",
  "port": 3000,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "endpoints": [
    {
      "endpoint": "/api/v1/store/stock/{storeId}",
      "method": "GET",
      "backend": [
        {
          "host": [
            "http://store:3000"
          ],
          "url_pattern": "/api/v1/store/stock/{storeId}",
          "encoding": "json"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "capacity": 100
        }
      }
    },
    {
      "endpoint": "/api/v1/store/sales",
      "method": "POST",
      "backend": [
        {
          "host": [
            "http://store:3000"
          ],
          "url_pattern": "/api/v1/store/sales",
          "encoding": "json"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "capacity": 50
        }
      }
    },
    {
      "endpoint": "/api/v1/store/reports/sales",
      "method": "GET",
      "backend": [
        {
          "host": [
            "http://store:3000"
          ],
          "url_pattern": "/api/v1/store/reports/sales",
          "encoding": "json"
        }
      ],
      "input_query_strings": [
        "startDate",
        "endDate"
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 20,
          "capacity": 20
        }
      }
    },
    {
      "endpoint": "/api/v1/store/products/{productId}",
      "method": "PUT",
      "backend": [
        {
          "host": [
            "http://store:3000"
          ],
          "url_pattern": "/api/v1/store/products/{productId}",
          "encoding": "json"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 30,
          "capacity": 30
        }
      }
    },
    {
      "endpoint": "/api/v1/store/metrics",
      "method": "GET",
      "backend": [
        {
          "host": [
            "http://store:3000"
          ],
          "url_pattern": "/api/v1/store/metrics",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 200,
          "capacity": 200
        }
      }
    }
  ],
  "extra_config": {
    "telemetry/metrics": {
      "collection_time": "60s",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": ":8090"
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["Content-Type", "Authorization", "X-Requested-With"],
      "expose_headers": ["Content-Length", "X-Krakend"],
      "max_age": "12h",
      "allow_credentials": false
    }
  }
}
