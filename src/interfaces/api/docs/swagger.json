{
	"openapi": "3.0.0",
	"info": {
		"title": "API Multi-Magasins – LOG430",
		"version": "1.0.0",
		"description": "Cette API RESTful permet d'interagir avec un système multi-magasins conformément au laboratoire 3 du cours LOG430 (Architecture Logicielle).\n\nElle expose quatre cas d’usage principaux (UC1 à UC4), en suivant les principes de Clean Architecture, REST et DDD léger.\n\n**Fonctionnalités disponibles :**\n- Génération de rapports consolidés\n- Consultation de stock par magasin\n- Visualisation de performances globales\n- Mise à jour d’un produit existant"
	},
	"paths": {
		"/api/v1/auth/login": {
			"post": {
				"tags": ["auth"],
				"summary": "Connexion utilisateur",
				"description": "Permet de se connecter avec un nom d’utilisateur et un mot de passe",
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"example": {
								"username": "admin",
								"password": "password"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Connexion réussie",
						"schema": {
							"type": "object",
							"properties": {
								"token": {
									"type": "string"
								}
							}
						}
					},
					"401": {
						"description": "Identifiants invalides"
					},
					"400": {
						"description": "Requête mal formée"
					}
				}
			}
		},
		"/api/v1/reports/sales": {
			"get": {
				"summary": "UC1 – Générer un rapport consolidé des ventes",
				"description": "Permet d’obtenir un résumé des ventes pour tous les magasins entre deux dates données.",
				"parameters": [
					{
						"name": "from",
						"in": "query",
						"required": true,
						"description": "Date de début (format ISO 8601)",
						"schema": {
							"type": "string",
							"format": "date"
						}
					},
					{
						"name": "to",
						"in": "query",
						"required": true,
						"description": "Date de fin (format ISO 8601)",
						"schema": {
							"type": "string",
							"format": "date"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Rapport généré avec succès",
						"content": {
							"application/json": {
								"example": {
									"startDate": "2025-06-01",
									"endDate": "2025-06-10",
									"summaryByStore": [
										{
											"storeName": "Magasin Centre-Ville",
											"totalSales": 42,
											"topProducts": [
												{
													"name": "Pain",
													"quantity": 5,
													"price": 1.2
												}
											]
										}
									]
								}
							}
						}
					},
					"400": {
						"description": "Requête invalide"
					},
					"500": {
						"description": "Erreur interne"
					}
				},
				"tags": ["hq"],
				"security": [
					{
						"BearerAuth": []
					}
				]
			}
		},
		"/api/v1/stores/{storeId}/stock": {
			"get": {
				"summary": "UC2 – Consulter le stock d’un magasin",
				"description": "Retourne l’inventaire complet d’un magasin donné via son ID.",
				"parameters": [
					{
						"name": "storeId",
						"in": "path",
						"required": true,
						"description": "Identifiant numérique du magasin",
						"schema": {
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Inventaire retourné avec succès",
						"content": {
							"application/json": {
								"example": {
									"storeId": 1,
									"items": [
										{
											"productId": 4,
											"name": "Lait",
											"stock": 93,
											"threshold": 20
										}
									]
								}
							}
						}
					},
					"400": {
						"description": "Identifiant invalide"
					},
					"500": {
						"description": "Erreur serveur"
					}
				},
				"tags": ["retail"],
				"security": [
					{
						"BearerAuth": []
					}
				]
			}
		},
		"/api/v1/dashboard": {
			"get": {
				"summary": "UC3 – Visualiser les performances globales",
				"description": "Retourne un tableau de bord global contenant :\n- Chiffre d’affaires par magasin\n- Produits en surstock ou en rupture\n- Tendances hebdomadaires des ventes",
				"responses": {
					"200": {
						"description": "Tableau de bord généré",
						"content": {
							"application/json": {
								"example": {
									"revenueByStore": [
										{
											"storeName": "Magasin A",
											"total": 150.0
										}
									],
									"stockAlerts": {
										"lowStock": [],
										"overStock": []
									},
									"weeklyTrends": [
										{
											"date": "2025-06-10",
											"total": 84.0
										}
									]
								}
							}
						}
					},
					"500": {
						"description": "Erreur serveur"
					}
				},
				"tags": ["hq"],
				"security": [
					{
						"BearerAuth": []
					}
				]
			}
		},
		"/api/v1/products/{productId}": {
			"put": {
				"summary": "UC4 – Mettre à jour un produit",
				"description": "Modifie les attributs d’un produit existant : nom, prix, catégorie, etc. Ne pas confondre avec l'inventaire d'un magasin qui contient les quantités en stock.",
				"parameters": [
					{
						"name": "productId",
						"in": "path",
						"required": true,
						"description": "Identifiant du produit à modifier",
						"schema": {
							"type": "integer"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"example": {
								"name": "Pomme Golden",
								"price": 1.6,
								"category": "Fruits"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Produit mis à jour",
						"content": {
							"application/json": {
								"example": {
									"id": 1,
									"name": "Pomme Golden",
									"price": 1.6,
									"category": "Fruits",
									"createdAt": "2025-06-10T12:00:00Z",
									"updatedAt": "2025-06-10T12:05:00Z"
								}
							}
						}
					},
					"400": {
						"description": "Requête invalide"
					},
					"404": {
						"description": "Produit non trouvé"
					},
					"500": {
						"description": "Erreur serveur"
					}
				},
				"tags": ["retail"],
				"security": [
					{
						"BearerAuth": []
					}
				]
			}
		}
	},
	"tags": [
		{
			"name": "hq",
			"description": "Fonctionnalités liées à la maison mère"
		},
		{
			"name": "retail",
			"description": "Opérations liées aux magasins"
		}
	],
	"components": {
		"securitySchemes": {
			"BearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "Utilisez le format : Bearer {votre_token}"
			}
		}
	}
}
