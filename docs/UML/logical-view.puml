@startuml logical-view
!theme plain
skinparam packageStyle rectangle

title Logical View

package "Auth Service" {
  class User {
    +id: Integer [PK]
    +username: String [unique]
    +password_hash: String
    +role: Enum(admin, employee, logistics, analyst, customer)
    +store_id: Integer [FK]
    +email: String
    +is_active: Boolean
    +created_at: Timestamp
    +updated_at: Timestamp
  }
}

package "Store Service" {
  class Store {
    +id: Integer [PK]
    +name: String
    +address: String
    +manager_id: Integer [FK]
    +is_active: Boolean
    +created_at: Timestamp
    +updated_at: Timestamp
  }
  
  class Product {
    +id: Integer [PK]
    +name: String
    +description: Text
    +price: Decimal(10,2)
    +category: String
    +store_id: Integer [FK]
    +is_active: Boolean
    +created_at: Timestamp
    +updated_at: Timestamp
  }
  
  class Inventory {
    +id: Integer [PK]
    +store_id: Integer [FK]
    +product_id: Integer [FK]
    +quantity: Integer
    +min_threshold: Integer
    +max_threshold: Integer
    +last_updated: Timestamp
  }
  
  class Sale {
    +id: Integer [PK]
    +store_id: Integer [FK]
    +product_id: Integer [FK]
    +user_id: Integer [FK]
    +quantity: Integer
    +unit_price: Decimal(10,2)
    +total_price: Decimal(10,2)
    +sale_date: Timestamp
  }
}

package "E-commerce Service" {
  class CartItem {
    +id: Integer [PK]
    +user_id: Integer [FK]
    +product_id: Integer [FK]
    +product_name: String
    +product_price: Decimal(10,2)
    +quantity: Integer
    +created_at: Timestamp
    +updated_at: Timestamp
  }
  
  class Order {
    +id: Integer [PK]
    +order_number: String [unique]
    +user_id: Integer [FK]
    +status: Enum(pending, confirmed, processing, shipped, delivered, cancelled)
    +total_amount: Decimal(10,2)
    +items: JSONB
    +shipping_address: JSONB
    +billing_address: JSONB
    +payment_method: JSONB
    +payment_status: Enum(pending, processing, completed, failed, refunded)
    +created_at: Timestamp
    +updated_at: Timestamp
  }
}

' Database Relationships
User ||--o{ Sale : creates
User ||--o{ CartItem : has
User ||--o{ Order : places
Store ||--o{ User : employs
Store ||--o{ Product : contains
Store ||--o{ Sale : records
Store ||--o{ Inventory : manages
Product ||--o{ Sale : sold_in
Product ||--o{ CartItem : added_as
Product ||--o{ Inventory : tracked_in

@enduml
    - userId: Integer
    - ipAddress: String
    - userAgent: String
    - success: Boolean
    - loginTime: DateTime
    --
    + isSuccessful(): Boolean
    + getLoginAttempts(timeframe: Duration): Integer
  }
}

package "E-commerce Domain" <<Rectangle>> {
  
  class Cart {
    - id: String
    - userId: Integer?
    - items: List<CartItem>
    - createdAt: DateTime
    - updatedAt: DateTime
    - expiresAt: DateTime
    --
    + addItem(productId: Integer, quantity: Integer): void
    + removeItem(productId: Integer): void
    + updateQuantity(productId: Integer, quantity: Integer): void
    + calculateTotal(): Decimal
    + clear(): void
    + isExpired(): Boolean
  }
  
  class CartItem {
    - productId: Integer
    - quantity: Integer
    - price: Decimal
    - addedAt: DateTime
    --
    + getSubtotal(): Decimal
    + updateQuantity(newQuantity: Integer): void
  }
  
  class Order {
    - id: Integer
    - userId: Integer?
    - cartId: String
    - status: OrderStatus
    - total: Decimal
    - createdAt: DateTime
    - completedAt: DateTime?
    --
    + process(): void
    + cancel(): void
    + complete(): void
  }
  
  enum OrderStatus {
    PENDING
    PROCESSING
    COMPLETED
    CANCELLED
  }
}

package "Authentication Domain" <<Rectangle>> {
  
  class JWTToken {
    - sub: String (userId)
    - username: String
    - role: String
    - storeId: Integer?
    - aud: List<String>
    - iss: String
    - exp: Long
    - iat: Long
    --
    + isValid(): Boolean
    + isExpired(): Boolean
    + hasAudience(audience: String): Boolean
    + hasRole(role: String): Boolean
  }
  
  class AuthSession {
    - token: JWTToken
    - user: User
    - createdAt: DateTime
    - lastAccessed: DateTime
    --
    + isActive(): Boolean
    + refresh(): JWTToken
    + invalidate(): void
  }
}

' Relationships
User ||--o{ Sale : "makes"
User }o--|| Store : "works at"
Store ||--o{ Inventory : "has"
Product ||--o{ Inventory : "stocked in"
Product ||--o{ Sale : "sold as"
Store ||--o{ Sale : "processes"
Sale }o--|| Product : "references"

User ||--o{ LoginLog : "generates"
User ||--o{ AuthSession : "has"
AuthSession ||--|| JWTToken : "contains"

User ||--o{ Cart : "owns"
Cart ||--o{ CartItem : "contains"
CartItem }o--|| Product : "references"
Cart ||--o{ Order : "generates"

SalesReport ||--o{ StoreSummary : "contains"
StoreSummary }o--|| Store : "summarizes"

' Value Objects and Enumerations
enum UserRole {
  ADMIN
  EMPLOYEE
  ANALYST
}

enum ProductCategory {
  BEVERAGES
  SNACKS
  DAIRY
  BAKERY
  FROZEN
  OTHER
}

class DateRange <<ValueObject>> {
  - startDate: Date
  - endDate: Date
  --
  + contains(date: Date): Boolean
  + getDuration(): Duration
}

User::role --> UserRole
Product::category --> ProductCategory
SalesReport --> DateRange

note top of User : "Central entity for authentication\nand authorization across all services"

note right of Sale : "Core transaction entity\ntracked for reporting and analytics"

note left of Cart : "Temporary shopping container\nwith expiration for cleanup"

note bottom of JWTToken : "Stateless authentication token\nwith role-based access control"

@enduml
