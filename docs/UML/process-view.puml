@startuml process-view
hide footbox
title Laboratory 6: Saga Orchestrated Checkout Process

actor Client
participant "KrakenD\n(API Gateway)" as Gateway
participant "E-commerce Service\nCheckout Controller" as EcomController
participant "Saga Orchestrator" as Orchestrator
participant "Saga Repository" as SagaRepo
participant "Store Service\nStock Controller" as StoreController
participant "Payment Service" as PaymentService
participant "Stock Reservation\nRepository" as StockRepo

Client -> Gateway : POST /api/v1/ecommerce/checkout/saga\n{items, paymentMethod, shippingAddress, token}
Gateway -> Gateway : Validate JWT
alt Token valid
    Gateway -> EcomController : Forward checkout request
    EcomController -> Orchestrator : startSaga("CHECKOUT_SAGA", checkoutData)
    
    Orchestrator -> SagaRepo : save(sagaInstance)
    SagaRepo --> Orchestrator : sagaId
    
    note over Orchestrator : Begin Saga Execution
    
    ' Step 1: Validate Stock
    Orchestrator -> StoreController : POST /stock/validate\n{items, sagaId, correlationId}
    StoreController -> StoreController : Check inventory availability
    alt Stock available
        StoreController --> Orchestrator : {success: true, available: true}
        
        ' Step 2: Reserve Stock
        Orchestrator -> StoreController : POST /stock/reserve\n{items, reservationId, sagaId}
        StoreController -> StockRepo : create reservation
        StockRepo --> StoreController : reservation created
        StoreController --> Orchestrator : {success: true, reservationId}
        
        ' Step 3: Process Payment
        Orchestrator -> PaymentService : processPayment(amount, paymentMethod, sagaId)
        PaymentService -> PaymentService : Process with payment provider
        alt Payment successful
            PaymentService --> Orchestrator : {success: true, transactionId}
            
            ' Step 4: Commit Stock Reservation
            Orchestrator -> StoreController : POST /stock/commit\n{reservationId, sagaId}
            StoreController -> StockRepo : update status to COMMITTED
            StockRepo --> StoreController : committed
            StoreController --> Orchestrator : {success: true}
            
            ' Step 5: Finalize Order
            Orchestrator -> Orchestrator : finalizeOrder()
            Orchestrator -> SagaRepo : updateState(sagaId, "COMPLETED")
            
            Orchestrator --> EcomController : {success: true, sagaId, orderId}
            EcomController --> Gateway : 201 Created {orderId, sagaId, status: "completed"}
            Gateway --> Client : 201 Created {orderId, sagaId}
            
        else Payment failed
            note over Orchestrator : Begin Compensation
            Orchestrator -> StoreController : POST /stock/release\n{reservationId, sagaId}
            StoreController -> StockRepo : update status to RELEASED
            Orchestrator -> SagaRepo : updateState(sagaId, "COMPENSATED")
            Orchestrator --> EcomController : {success: false, error: "Payment failed"}
            EcomController --> Gateway : 402 Payment Required
            Gateway --> Client : 402 Payment Required
        end
        
    else Stock insufficient
        Orchestrator -> SagaRepo : updateState(sagaId, "FAILED")
        Orchestrator --> EcomController : {success: false, error: "Insufficient stock"}
        EcomController --> Gateway : 409 Conflict
        Gateway --> Client : 409 Conflict
    end
    
else Token invalid
    Gateway --> Client : 401 Unauthorized
end

@enduml
